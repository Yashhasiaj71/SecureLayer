PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=

# JWT secrets
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP configuration (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AES-256 master key — 64 hex characters = 32 bytes = 256 bits
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_MASTER_KEY=

# Frontend URL (for CORS; Vite's default development port)
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
OTP_RATE_LIMIT_MAX=3

# OTP config
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# File upload
MAX_FILE_SIZE_MB=10
